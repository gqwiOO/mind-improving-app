<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kutochok.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="640"
             x:Class="Kutochok.Views.EditorPageView"
             x:DataType="vm:EditorPageViewModel">

    <DockPanel Margin="24,20,24,16">

        <!-- ===================== Шапка ===================== -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14" Spacing="3">
            <TextBlock Text="{Binding Title}" Classes="h1" />
            <TextBlock Text="{Binding FileHint}"
                       Classes="faint"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="11" />
        </StackPanel>

        <!-- ===================== Нижня панель ===================== -->
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="0,1,0,0"
                Padding="0,12,0,0"
                Margin="0,14,0,0">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <Button Grid.Column="0" Classes="primary" Content="Save" Click="OnSave" Margin="0,0,8,0" />
                <Button Grid.Column="1" Content="Back" Click="OnBack" />
                <TextBlock Grid.Column="2"
                           Name="StatusText"
                           Text="{Binding Status}"
                           VerticalAlignment="Center"
                           Margin="16,0"
                           FontSize="13" />
                <Button Grid.Column="3"
                        Classes="danger"
                        Content="Delete"
                        Click="OnDelete"
                        IsVisible="{Binding CanDelete}" />
            </Grid>
        </Border>

        <!-- ===================== Форма ===================== -->
        <Grid Name="Body" RowDefinitions="Auto,*">

            <ScrollViewer Grid.Row="0" Name="FieldsScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel Name="FieldsHost" Spacing="12" Margin="0,0,14,0" />
            </ScrollViewer>

            <!-- Блок markdown: панель інструментів, поле і передперегляд -->
            <Grid Grid.Row="1" Name="EditorArea" RowDefinitions="Auto,Auto,*" Margin="0,14,0,0">

                <TextBlock Grid.Row="0" Name="BodyLabel" Text="Text" Classes="label" />

                <Border Grid.Row="1"
                        Background="{DynamicResource AppPanel}"
                        BorderBrush="{DynamicResource AppBorder}"
                        BorderThickness="1,1,1,0"
                        CornerRadius="5,5,0,0"
                        Padding="4,3">
                    <Grid ColumnDefinitions="*,Auto">
                        <WrapPanel Grid.Column="0" Name="Toolbar" />
                        <ToggleButton Grid.Column="1"
                                      Name="PreviewToggle"
                                      Content="Preview"
                                      IsCheckedChanged="OnTogglePreview"
                                      Background="Transparent"
                                      BorderBrush="Transparent"
                                      Padding="8,3"
                                      FontSize="12" />
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource AppBorder}"
                        BorderThickness="1,0,1,1"
                        CornerRadius="0,0,5,5">
                    <Grid>
                        <TextBox Name="BodyBox"
                                 Classes="mono"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 BorderThickness="0"
                                 CornerRadius="0"
                                 Padding="12,10"
                                 TextChanged="OnBodyChanged" />

                        <ScrollViewer Name="PreviewScroll" IsVisible="False" Padding="14,12">
                            <ContentControl Name="PreviewHost" />
                        </ScrollViewer>
                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
