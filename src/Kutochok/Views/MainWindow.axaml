<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kutochok.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
        x:Class="Kutochok.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1100" Height="720"
        MinWidth="760" MinHeight="480"
        Title="Kutochok">

    <Grid ColumnDefinitions="220,*">

        <!-- ======================= Бічне меню ======================= -->
        <Border Grid.Column="0"
                Background="{DynamicResource AppPanel}"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="0,0,1,0">
            <Grid Margin="14,18,14,14" RowDefinitions="Auto,*,Auto">

                <StackPanel Grid.Row="0" Margin="4,0,0,16">
                    <TextBlock Text="Kutochok" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="everything of yours in one place" Classes="faint" />
                </StackPanel>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding Sections}" VerticalAlignment="Top">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SectionViewModel">
                            <Button Classes="nav"
                                    Classes.active="{Binding IsActive}"
                                    Click="OnSectionClick"
                                    Tag="{Binding}"
                                    Margin="0,1">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <TextBlock Text="{Binding Label}" />
                                    <TextBlock Text="{Binding Count}" Classes="faint" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Шлях до файлів — унизу, щоб завжди було видно, де вони -->
                <StackPanel Grid.Row="2" Margin="4,16,0,0" Spacing="6">
                    <TextBlock Text="Files live here:" Classes="faint" />
                    <TextBlock Text="{Binding ContentRoot}"
                               Classes="faint"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="10"
                               TextWrapping="Wrap" />
                    <Button Content="Open folder"
                            Click="OnOpenFolder"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            FontSize="12" />
                </StackPanel>

            </Grid>
        </Border>

        <!-- ======================= Вміст ======================= -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />

    </Grid>
</Window>
