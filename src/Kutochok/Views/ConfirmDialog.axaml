<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Kutochok.Views.ConfirmDialog"
        Width="400"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Title="Підтвердження">

    <StackPanel Margin="22,20" Spacing="14">
        <TextBlock Name="HeadingText" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Name="MessageText" Classes="muted" />

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Скасувати" Click="OnCancel" />
            <Button Content="Видалити" Classes="danger" Click="OnConfirm" />
        </StackPanel>
    </StackPanel>
</Window>
